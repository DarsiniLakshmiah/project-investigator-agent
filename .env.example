# Copy to .env for local development. .env is git-ignored.
# Real environment variables always take precedence over values in .env.
# Every WBC_* variable overrides the matching key in configs/environments/*.yaml.

# Runtime environment: local | databricks
# If unset, "databricks" is auto-selected when DATABRICKS_RUNTIME_VERSION is present,
# otherwise "local".
WBC_ENV=local

WBC_LOG_LEVEL=INFO

# --- Data locations ----------------------------------------------------------
# Local: relative paths resolve against the repository root.
WBC_LOCAL_DATA_ROOT=data
# Databricks: defaults to /Volumes/<catalog>/<bronze_schema>/<source_volume>/data.
# Uncomment only to override. (A blank value would mean "not configured".)
# WBC_DATABRICKS_VOLUME_ROOT=

# --- Unity Catalog -----------------------------------------------------------
# Defaults live in configs/environments/base.yaml (catalog worldbank_copilot, schemas
# bronze / silver / gold, Volumes sources / pipeline_artifacts). Uncomment to override.
# WBC_CATALOG=worldbank_copilot
# WBC_BRONZE_SCHEMA=bronze
# WBC_SILVER_SCHEMA=silver
# WBC_GOLD_SCHEMA=gold
# WBC_SOURCE_VOLUME=sources
# WBC_ARTIFACT_VOLUME=pipeline_artifacts

# --- Databricks Vector Search ------------------------------------------------
WBC_VECTOR_SEARCH_ENDPOINT=
WBC_VECTOR_SEARCH_INDEX=

# --- Model Serving endpoints -------------------------------------------------
WBC_EMBEDDING_ENDPOINT=
WBC_LLM_ENDPOINT=

# --- MLflow -----------------------------------------------------------------
# e.g. /Users/<you>/wb-implementation-copilot
WBC_MLFLOW_EXPERIMENT=

# --- Optional: config directory override ------------------------------------
# Only needed if the package is installed somewhere without the repo's configs/.
# WBC_CONFIG_DIR=

# --- Databricks SDK auth (only for later phases, never needed for unit tests) -
# DATABRICKS_HOST=
# DATABRICKS_TOKEN=

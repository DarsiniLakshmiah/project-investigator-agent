# ---------------------------------------------------------------------------
# Source data — never commit datasets or PDFs.
# Only data/README.md (placement instructions) is tracked.
# ---------------------------------------------------------------------------
data/**
!data/
!data/README.md

*.pdf
*.xlsx
*.xls
*.csv
*.parquet
*.delta
# Test fixtures are small, synthetic and allowed.
!tests/fixtures/**
# Human review artefacts (derived metadata, no source data) are tracked.
!review/*.csv

# ---------------------------------------------------------------------------
# Secrets / local environment
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.databrickscfg

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv-*/
venv/
# Local developer tooling (portable JDK for local Spark tests)
.tools/
spark-warehouse/
metastore_db/
derby.log
.python-version

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Local artefacts
# ---------------------------------------------------------------------------
mlruns/
mlartifacts/
.local_output/
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Databricks bundle local state
.databricks/
